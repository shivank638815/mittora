# Browser Configuration
HEADLESS=false

# Meeting Configuration
SOLO_TIMEOUT_MINUTES=8
MAX_MEETING_MINUTES=240
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=30

# Chat Configuration
GREETING_MESSAGE=Hello everyone

# Storage Configuration
# Leave empty to use project directory, or specify custom path
STORAGE_PATH=

# Screenshot Configuration (OPTIMIZED)
# Enable screenshot capture (true/false)
SCREENSHOT_ENABLED=true
# Interval between screenshot checks in seconds (2-30 recommended)
# Lower = more frequent checks, catches changes faster
SCREENSHOT_INTERVAL_SECONDS=3
# Perceptual hash threshold for quick change detection (1-20)
# Lower = more sensitive, Higher = less sensitive
SCREENSHOT_HASH_THRESHOLD=5
# Pixel difference threshold as percentage (0.5-10.0)
# Percentage of pixels that must differ to save screenshot
# Lower = saves more similar screenshots, Higher = only major changes
SCREENSHOT_PIXEL_THRESHOLD=1.5


# Audio Recording Configuration
# Enable system-audio capture using Windows WASAPI loopback (true/false)
AUDIO_PREFER_LOOPBACK=true
# Optional explicit device ID or name (if blank, autodetect)
AUDIO_DEVICE=
# Prefer devices containing this name when selecting loopback (e.g., "speakers")
AUDIO_LOOPBACK_DEVICE_NAME=
# Target WAV sample rate (must be supported by device)
AUDIO_SAMPLE_RATE=16000
